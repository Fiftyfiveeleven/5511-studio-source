NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# Optional allowlist: comma-separated email addresses. Empty permits all authenticated users.
STUDIO_ALLOWED_EMAILS=
# GitHub-to-Vercel deployment does not require a VERCEL_TOKEN.
# Do not import local VERCEL_* authentication variables into Vercel project settings.

# Optional browser sign-in for GitHub. A personal token can be entered in Settings without these.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://127.0.0.1:3001/api/github/oauth/callback

# Server-only Supabase secret (or legacy SUPABASE_SERVICE_ROLE_KEY).
# Required for durable token budgets and request deduplication on Vercel.
SUPABASE_SECRET_KEY=

# Simple visual edits; complex builds continue to use OPENAI_MODEL.
OPENAI_FAST_MODEL=gpt-5.4-mini

# Phase 1: durable builds and isolated Next.js runtime (Studio server only)
# Generate once with: openssl rand -hex 32. Keep stable across deployments.
STUDIO_JOB_ENCRYPTION_KEY=
# Explicit opt-in: Vercel Sandbox compute charges are separate from OpenAI.
STUDIO_SANDBOX_ENABLED=false
# Optional snapshot with Chromium + playwright@1.58.2 at /vercel/checker.
STUDIO_SANDBOX_SNAPSHOT=
# On Vercel, Sandbox uses deployment OIDC. For local use, also configure
# VERCEL_TOKEN, VERCEL_TEAM_ID and VERCEL_PROJECT_ID on the server.
